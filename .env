# Safe defaults only. Override in .env.local or deployment environment.
APP_ENV=dev
APP_SECRET=change-this-in-local-and-production
DEFAULT_URI=http://localhost:8741
DATABASE_URL="mysql://forge:forge@db:3306/forge?serverVersion=10.11.0-MariaDB&charset=utf8mb4"
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-this-in-local-and-production
CORS_ALLOW_ORIGIN='^http://localhost:3000$'
